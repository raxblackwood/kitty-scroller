<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EE121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="#333333"
            app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿"
                android:textSize="36sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pause &amp; Breathe"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="60-Second Cooling-Off Period"
                android:textColor="@color/secondary"
                android:textSize="13sp"
                android:letterSpacing="0.06"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Your brain is seeking an immediate dopamine fix. This impulsive urge to uninstall almost always subsides within 60 seconds."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />

            <!-- Reassurance Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#252525"
                app:cardCornerRadius="12dp"
                app:strokeColor="#3A3A3A"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Clawse only limits reels. WhatsApp, Chrome, Notion, Phone, and all other apps are 100% accessible."
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="1dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Circular Progress Countdown Section -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressCountdown"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:max="60"
                    android:progress="60"
                    app:indicatorColor="@color/primary"
                    app:trackColor="@color/surface_variant"
                    app:trackThickness="8dp"
                    app:indicatorSize="120dp"
                    app:trackCornerRadius="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvCountdownSeconds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60"
                        android:textColor="@color/text_primary"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="seconds"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Action Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeepFocus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keep My Focus (Return Home)"
                android:textColor="@color/on_primary"
                android:backgroundTint="@color/primary"
                app:cornerRadius="12dp"
                android:paddingVertical="12dp"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProceedDeactivate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Wait 60s to Modify Settings"
                android:textColor="@color/text_secondary"
                android:backgroundTint="@color/surface_variant"
                android:enabled="false"
                android:alpha="0.5"
                app:cornerRadius="12dp"
                android:textSize="13sp"
                style="@style/Widget.Material3.Button.TonalButton" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>