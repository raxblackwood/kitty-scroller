<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_pixel_dark_dialog"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <!-- Top bar with Brand & Skip -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@mipmap/ic_kitty_launcher"
                android:contentDescription="Clawse" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Clawse"
                android:textColor="@color/pixel_dark_ink_bright"
                android:textSize="18sp"
                android:fontFamily="@font/silkscreen_bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnOnboardingSkip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center"
            android:text="Skip"
            android:textColor="@color/pixel_dark_ink_muted"
            android:textSize="13sp"
            android:fontFamily="@font/bricolage_grotesque"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- ViewPager2 for Slides -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pagerOnboarding"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Dot Indicators -->
    <LinearLayout
        android:id="@+id/layoutDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical" />

    <!-- Action Button (Continue / Get Started) -->
    <TextView
        android:id="@+id/btnOnboardingAction"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_pixel_dark_btn_action"
        android:gravity="center"
        android:text="Continue"
        android:textColor="@color/pixel_dark_bg"
        android:textSize="14sp"
        android:fontFamily="@font/silkscreen_bold"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
