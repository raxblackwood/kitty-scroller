<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="@drawable/bg_pixel_dark_dialog">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to Clawse 🐾"
            android:textColor="@color/pixel_dark_ink_bright"
            android:textSize="20sp"
            android:fontFamily="@font/silkscreen_bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Choose your daily reel boundary before you start. Once locked in, this budget protects your focus."
            android:textColor="@color/pixel_dark_ink_muted"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="@font/bricolage_grotesque" />

        <!-- 1. Limit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="1. DAILY REEL LIMIT"
            android:textColor="@color/pixel_dark_awning_yellow"
            android:textSize="11.5sp"
            android:letterSpacing="0.06"
            android:fontFamily="@font/silkscreen_bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pixel_dark_input_box">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSetupLimit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="number"
                android:maxLength="4"
                android:hint="Example: 25"
                android:textColorHint="@color/pixel_dark_ink_muted"
                android:textColor="@color/pixel_dark_ink_bright"
                android:textSize="15sp"
                android:fontFamily="@font/silkscreen_regular" />
        </FrameLayout>

        <!-- 2. Protected Apps -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="2. PROTECTED APPS"
            android:textColor="@color/pixel_dark_awning_yellow"
            android:textSize="11.5sp"
            android:letterSpacing="0.06"
            android:fontFamily="@font/silkscreen_bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSetupInstagram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:checked="true"
            android:text="Instagram (Reels &amp; Feed)"
            android:textColor="@color/pixel_dark_ink_bright"
            android:textSize="14sp"
            android:fontFamily="@font/bricolage_grotesque" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSetupYouTube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="YouTube (Shorts)"
            android:textColor="@color/pixel_dark_ink_bright"
            android:textSize="14sp"
            android:fontFamily="@font/bricolage_grotesque" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSetupSnapchat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Snapchat (Spotlight)"
            android:textColor="@color/pixel_dark_ink_bright"
            android:textSize="14sp"
            android:fontFamily="@font/bricolage_grotesque" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSetupFacebook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Facebook (Reels)"
            android:textColor="@color/pixel_dark_ink_bright"
            android:textSize="14sp"
            android:fontFamily="@font/bricolage_grotesque" />

        <!-- Lock In Button -->
        <TextView
            android:id="@+id/btnLockInSetup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Lock In Daily Boundary 🔒"
            android:textColor="@color/pixel_dark_bg"
            android:textSize="13sp"
            android:background="@drawable/bg_pixel_dark_btn_action"
            android:fontFamily="@font/silkscreen_bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
