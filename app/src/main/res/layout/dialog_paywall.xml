<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginBottom="16dp"
            android:background="#444444" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐾 ClawBack Premium"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Ginger is 100% free forever. Upgrade your experience or protect your family below."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Card: Cosmetic Pack -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCosmetics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="✨ ALL-CATS COSMETIC PACK"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:letterSpacing="0.06"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCosmeticsPriceBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#33FF6E40"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="$2.50 ONE-TIME"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Unlock Tabby, Saturn, and Rolex"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Breed Pills Showcase -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@color/surface_variant"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="🐈‍⬛ Tabby"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@color/surface_variant"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="🕶️ Saturn"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@color/surface_variant"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="🐱 Rolex"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Stealth Black Tabby with glowing green eyes\n• Saturn the Gangster Cat with shades and cigar\n• Rolex with golden luxury collar and paw-tience\n• Lifetime unlock forever across all your Android devices"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="💳 Cards &amp; 📱 UPI (GPay, PhonePe, Paytm) via Google Play"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuyCosmetics"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Unlock All Breeds • $2.50"
                    android:textColor="@color/on_primary"
                    android:backgroundTint="@color/primary"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Guardian Parental Control -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardParental"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/secondary"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🛡️ GUARDIAN PARENTAL ALERT"
                        android:textColor="@color/secondary"
                        android:textSize="12sp"
                        android:letterSpacing="0.06"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvParentalPriceBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#3326A69A"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="$0.50 / MONTH"
                        android:textColor="@color/secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Instant Child Phone Uninstall Alerts"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="• Immediate push notification / webhook to guardian's phone\n• Intercepts uninstall dialogs and device admin deactivations\n• 15-minute 'Dead Man's Switch' heartbeat monitoring\n• Delivered via Discord, Slack, ntfy.sh, or custom Webhook"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="💳 Cards &amp; 📱 UPI via Google Play Subscriptions • Cancel anytime"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBuyParental"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Subscribe Guardian Alert • $0.50 / mo"
                    android:textColor="@color/on_secondary"
                    android:backgroundTint="@color/secondary"
                    android:textStyle="bold"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Restore Purchases -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestorePurchases"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 Restore Previous Purchases"
            android:textColor="@color/text_secondary"
            style="@style/Widget.Material3.Button.TextButton" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Secured by Google Play Billing. Subscriptions renew automatically unless cancelled in Google Play Store settings."
            android:textColor="#666666"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
