<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_pixel_dark_dialog"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change Daily Reel Limit 🎯"
        android:textColor="@color/pixel_dark_ink_bright"
        android:textSize="18sp"
        android:fontFamily="@font/silkscreen_bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Tightening your limit takes effect immediately. Increasing your limit takes effect tomorrow at midnight to prevent binge scrolling."
        android:textColor="@color/pixel_dark_ink_muted"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:fontFamily="@font/bricolage_grotesque" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_pixel_dark_input_box">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etChangeLimit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="number"
            android:maxLength="4"
            android:hint="Example: 25"
            android:textColorHint="@color/pixel_dark_ink_muted"
            android:textColor="@color/pixel_dark_ink_bright"
            android:textSize="15sp"
            android:fontFamily="@font/silkscreen_regular" />
    </FrameLayout>

    <TextView
        android:id="@+id/btnSaveChangeLimit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Update Daily Boundary 🔒"
        android:textColor="@color/pixel_dark_bg"
        android:textSize="13sp"
        android:background="@drawable/bg_pixel_dark_btn_action"
        android:fontFamily="@font/silkscreen_bold"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnCancelChangeLimit"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Cancel"
        android:textColor="@color/pixel_dark_ink_muted"
        android:textSize="13sp"
        android:fontFamily="@font/bricolage_grotesque"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
