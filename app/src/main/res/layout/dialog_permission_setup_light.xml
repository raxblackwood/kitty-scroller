<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_sticker_dialog_paper">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable Kitty Curtain 🐾"
                android:textColor="@color/sticker_ink"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/bricolage_grotesque" />

            <ImageView
                android:id="@+id/btnClosePermDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/sticker_ink" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="To count reels and lower the curtain when your limit is reached, please enable these 2 Android permissions:"
            android:textColor="@color/sticker_ink_soft"
            android:textSize="13.5sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="@font/bricolage_grotesque" />

        <!-- 1. Display Over Other Apps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Display Over Other Apps"
                    android:textColor="@color/sticker_ink"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Lowers the Kitty Curtain over reels"
                    android:textColor="@color/sticker_ink_soft"
                    android:textSize="12sp"
                    android:fontFamily="@font/bricolage_grotesque" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSetupOverlay"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="Enable"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/sticker_ink"
                android:background="@drawable/bg_sticker_card_yellow"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/bricolage_grotesque" />
        </LinearLayout>

        <!-- 2. Accessibility Service -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Accessibility Service"
                    android:textColor="@color/sticker_ink"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tracks reels &amp; stops uninstalls"
                    android:textColor="@color/sticker_ink_soft"
                    android:textSize="12sp"
                    android:fontFamily="@font/bricolage_grotesque" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSetupAccessibility"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="Enable"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/sticker_ink"
                android:background="@drawable/bg_sticker_card_yellow"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/bricolage_grotesque" />
        </LinearLayout>

        <!-- Actions -->
        <TextView
            android:id="@+id/btnDonePermissions"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_sticker_action_dark"
            android:gravity="center"
            android:text="Done / Go to Dashboard"
            android:textColor="@color/sticker_paper"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/bricolage_grotesque" />

        <TextView
            android:id="@+id/btnSkipPermissions"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="I'll Enable Later"
            android:textColor="@color/sticker_ink_muted"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/bricolage_grotesque" />

    </LinearLayout>
</ScrollView>