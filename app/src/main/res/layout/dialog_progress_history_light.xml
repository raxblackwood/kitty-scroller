<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sticker_progress_sheet"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Drag handle -->
        <View
            android:layout_width="44dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_sticker_dot_active" />

        <!-- Title & Subtitle Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_sticker_circle_btn_yellow">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chart_progress"
                    app:tint="@color/sticker_ink" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Focus Progress &amp; Trends"
                    android:textColor="@color/sticker_ink"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Past 7 days activity vs your daily boundary"
                    android:textColor="@color/sticker_ink_soft"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/bricolage_grotesque" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bento Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_sticker_card_paper"
            android:orientation="horizontal"
            android:padding="16dp"
            android:weightSum="3">

            <!-- 1. Days Met Budget -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatDaysUnderBudget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- / 7"
                    android:textColor="@color/sticker_ink"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="UNDER BUDGET"
                    android:textColor="@color/sticker_ink_muted"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />
            </LinearLayout>

            <!-- 2. Daily Average -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatDailyAvg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/sticker_ink"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="DAILY AVG"
                    android:textColor="@color/sticker_ink_muted"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />
            </LinearLayout>

            <!-- 3. Active Cap -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatActiveCap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/sticker_ink"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="DAILY CAP"
                    android:textColor="@color/sticker_ink_muted"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vertical Bar Chart Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_sticker_card_paper"
            android:padding="12dp">

            <com.antiscroller.kitty.ui.DailyBarChartView
                android:id="@+id/chartDailyBars"
                android:layout_width="match_parent"
                android:layout_height="220dp" />
        </FrameLayout>

        <!-- Selected Day Detail Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_sticker_card_yellow"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSelectedDayTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Selected Day"
                    android:textColor="@color/sticker_ink"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <TextView
                    android:id="@+id/tvSelectedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mindful Day"
                    android:textColor="@color/sticker_mint_dark"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSelectedDaySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 of 25 reels watched"
                android:textColor="@color/sticker_ink_soft"
                android:textSize="13.5sp"
                android:fontFamily="@font/bricolage_grotesque" />
        </LinearLayout>

        <!-- Done / Dismiss Button -->
        <TextView
            android:id="@+id/btnDoneHistory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_sticker_action_dark"
            android:gravity="center"
            android:text="Back to Dashboard"
            android:textColor="@color/sticker_paper"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/bricolage_grotesque" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>