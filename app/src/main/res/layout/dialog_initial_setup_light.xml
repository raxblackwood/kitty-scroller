<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_sticker_dialog_paper">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to Clawse 🐾"
            android:textColor="@color/sticker_ink"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Choose your daily reel boundary before you start. Once locked in, this budget protects your focus."
            android:textColor="@color/sticker_ink_soft"
            android:textSize="13.5sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="@font/bricolage_grotesque" />

        <!-- 1. Limit -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="1. DAILY REEL LIMIT"
            android:textColor="@color/sticker_ink"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_sticker_input_box">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSetupLimit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="number"
                android:maxLength="4"
                android:hint="Example: 25"
                android:textColorHint="@color/sticker_ink_muted"
                android:textColor="@color/sticker_ink"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/bricolage_grotesque" />
        </FrameLayout>

        <!-- 2. Protected Apps -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="2. PROTECTED APPS"
            android:textColor="@color/sticker_ink"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textStyle="bold"
            android:fontFamily="@font/bricolage_grotesque" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSetupInstagram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"
            android:text="Instagram (Reels &amp; Feed)"
            android:textColor="@color/sticker_ink"
            android:textSize="14.5sp"
            android:fontFamily="@font/bricolage_grotesque"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSetupYouTube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="YouTube (Shorts)"
            android:textColor="@color/sticker_ink"
            android:textSize="14.5sp"
            android:fontFamily="@font/bricolage_grotesque"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSetupSnapchat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Snapchat (Spotlight)"
            android:textColor="@color/sticker_ink"
            android:textSize="14.5sp"
            android:fontFamily="@font/bricolage_grotesque"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSetupFacebook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Facebook (Reels)"
            android:textColor="@color/sticker_ink"
            android:textSize="14.5sp"
            android:fontFamily="@font/bricolage_grotesque"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnLockInSetup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_sticker_card_yellow"
            android:gravity="center"
            android:text="Lock In Daily Boundary 🔒"
            android:textColor="@color/sticker_ink"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/bricolage_grotesque" />

    </LinearLayout>
</ScrollView>