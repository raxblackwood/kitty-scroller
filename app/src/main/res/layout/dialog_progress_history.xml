<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pixel_dark_dialog"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Drag handle -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@color/pixel_dark_stroke" />

        <!-- Title & Subtitle Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_pixel_dark_btn_menu">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chart_progress"
                    app:tint="@color/pixel_dark_ink_bright" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Focus Progress &amp; Trends"
                    android:textColor="@color/pixel_dark_ink_bright"
                    android:textSize="18sp"
                    android:fontFamily="@font/silkscreen_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Past 7 days activity vs your daily boundary"
                    android:textColor="@color/pixel_dark_ink_muted"
                    android:textSize="12.5sp"
                    android:fontFamily="@font/bricolage_grotesque" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bento Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pixel_dark_cat_card_unselected"
            android:orientation="horizontal"
            android:padding="16dp"
            android:weightSum="3">

            <!-- 1. Days Met Budget -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatDaysUnderBudget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- / 7"
                    android:textColor="@color/pixel_dark_awning_yellow"
                    android:textSize="18sp"
                    android:fontFamily="@font/silkscreen_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="IN BUDGET"
                    android:textColor="@color/pixel_dark_ink_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />
            </LinearLayout>

            <!-- 2. Daily Average -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatDailyAvg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/pixel_dark_ink_bright"
                    android:textSize="18sp"
                    android:fontFamily="@font/silkscreen_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="DAILY AVG"
                    android:textColor="@color/pixel_dark_ink_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />
            </LinearLayout>

            <!-- 3. Active Cap -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStatActiveCap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/pixel_dark_ink_bright"
                    android:textSize="18sp"
                    android:fontFamily="@font/silkscreen_bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="DAILY CAP"
                    android:textColor="@color/pixel_dark_ink_muted"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vertical Bar Chart Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pixel_dark_cat_card_unselected"
            android:padding="12dp">

            <com.antiscroller.kitty.ui.DailyBarChartView
                android:id="@+id/chartDailyBars"
                android:layout_width="match_parent"
                android:layout_height="220dp" />
        </FrameLayout>

        <!-- Selected Day Detail Card -->
        <LinearLayout
            android:id="@+id/cardSelectedDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_pixel_dark_cat_card_selected"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSelectedDayTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Selected Day"
                    android:textColor="@color/pixel_dark_ink_bright"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />

                <TextView
                    android:id="@+id/tvSelectedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mindful Day"
                    android:textColor="@color/pixel_dark_awning_yellow"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/bricolage_grotesque" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSelectedDaySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 of 25 reels watched"
                android:textColor="@color/pixel_dark_ink_muted"
                android:textSize="13.5sp"
                android:fontFamily="@font/bricolage_grotesque" />
        </LinearLayout>

        <!-- Done / Dismiss Button -->
        <TextView
            android:id="@+id/btnDoneHistory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_pixel_dark_btn_action"
            android:gravity="center"
            android:text="Back to Dashboard"
            android:textColor="@color/pixel_dark_bg"
            android:textSize="14sp"
            android:fontFamily="@font/silkscreen_bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
